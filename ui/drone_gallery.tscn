[ext_resource type="PackedScene" path="res://ui/components/background.tscn" id="2_background"]
[ext_resource type="PackedScene" path="res://games/dead_metal_jam/ui/drone_preview_card.tscn" id="3_card"]

[node name="DroneGallery" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Background" parent="." instance=ExtResource("2_background")]

[node name="Margins" type="MarginContainer" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 48
theme_override_constants/margin_top = 36
theme_override_constants/margin_right = 48
theme_override_constants/margin_bottom = 36

[node name="Layout" type="VBoxContainer" parent="Margins"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Eyebrow" type="Label" parent="Margins/Layout"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.784314, 0.415686, 1)
theme_override_font_sizes/font_size = 16
text = "DEAD METAL JAM / ART GARAGE"

[node name="Heading" type="HBoxContainer" parent="Margins/Layout"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Title" type="Label" parent="Margins/Layout/Heading"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.956863, 0.929412, 0.866667, 1)
theme_override_font_sizes/font_size = 44
text = "DRONE ROSTER"
autowrap_mode = 3

[node name="CloseButton" type="Button" parent="Margins/Layout/Heading"]
layout_mode = 2
size_flags_vertical = 4
text = "Close"

[node name="Intro" type="Label" parent="Margins/Layout"]
layout_mode = 2
theme_override_colors/font_color = Color(0.647059, 0.72549, 0.737255, 1)
theme_override_font_sizes/font_size = 19
text = "Study the silhouettes, cycle the note plates, and inspect the charge poses."
autowrap_mode = 3

[node name="Controls" type="BoxContainer" parent="Margins/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 18

[node name="CycleNotes" type="Button" parent="Margins/Layout/Controls"]
layout_mode = 2
text = "Cycle notes / plates"

[node name="ChargePose" type="CheckButton" parent="Margins/Layout/Controls"]
unique_name_in_owner = true
layout_mode = 2
text = "Charge pose"

[node name="PauseMotion" type="CheckButton" parent="Margins/Layout/Controls"]
unique_name_in_owner = true
layout_mode = 2
text = "Pause motion"

[node name="Scroll" type="ScrollContainer" parent="Margins/Layout"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Roster" type="GridContainer" parent="Margins/Layout/Scroll"]
