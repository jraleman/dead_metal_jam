layout_mode = 2

[node name="PlatedCard" parent="Margins/Layout/Scroll/Roster" instance=ExtResource("3_card")]
unique_name_in_owner = true
layout_mode = 2

[node name="SentryCard" parent="Margins/Layout/Scroll/Roster" instance=ExtResource("3_card")]
unique_name_in_owner = true
layout_mode = 2

[node name="ConductorCard" parent="Margins/Layout/Scroll/Roster" instance=ExtResource("3_card")]
